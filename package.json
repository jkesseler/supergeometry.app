{
  "name": "supergeometry",
  "private": true,
  "version": "0.6.0",
  "description": "Free, browser-based solid modeler for every device.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "node node_modules/typescript-native/bin/tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
    "lint": "eslint .",
    "check": "tsx scripts/check.ts",
    "render": "tsx scripts/render.ts",
    "live": "tsx scripts/live.ts"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "opentype.js": "^2.0.0",
    "preact": "^11.2.0",
    "replicad": "^1.2.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
